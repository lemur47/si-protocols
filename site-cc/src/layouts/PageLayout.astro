---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  prev?: { href: string; label: string };
  next?: { href: string; label: string };
}

const { title, description, prev, next } = Astro.props;

const pageSlug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
const ogImage = pageSlug ? `/images/og/${pageSlug}.png` : undefined;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  ...(description && { description }),
  publisher: {
    '@type': 'Organization',
    name: 'SI Protocols',
    url: 'https://spiritualintelligence.cc',
  },
  url: `https://spiritualintelligence.cc${Astro.url.pathname}`,
};
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <article class="page">
    <header class="page-header">
      <h1>{title}</h1>
    </header>
    <div class="page-content">
      <slot />
    </div>
    {(prev || next) && (
      <nav class="page-nav">
        {prev ? (
          <a href={prev.href} class="nav-link prev">&larr; {prev.label}</a>
        ) : (
          <span />
        )}
        {next ? (
          <a href={next.href} class="nav-link next">{next.label} &rarr;</a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .page {
    max-width: 880px;
    margin: 0 auto;
    padding: 56px var(--si-gutter) 80px;
  }

  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--si-line);
  }

  .page-header h1 {
    font-size: var(--si-fs-2xl);
    line-height: 1.1;
    margin: 0;
  }

  .page-content {
    margin-bottom: 3rem;
    font-family: var(--si-sans);
    font-size: var(--si-fs-md);
    line-height: 1.7;
    max-width: 720px;
  }

  .page-content :global(h2) {
    margin-top: 2.5rem;
  }

  .page-content :global(a) {
    color: var(--si-amber);
    border-bottom: 1px solid var(--si-amber-dim);
  }

  .page-content :global(a:hover) {
    color: var(--si-fg);
  }

  .page-nav {
    display: flex;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--si-line);
    font-family: var(--si-mono);
    font-size: var(--si-fs-sm);
  }

  .nav-link {
    color: var(--si-fg-muted);
  }

  .nav-link:hover {
    color: var(--si-amber);
  }

  .nav-link.next {
    margin-left: auto;
    text-align: right;
  }
</style>
