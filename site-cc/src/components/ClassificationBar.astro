---
const REV = '2026.05';
---

<div class="bar">
  <div class="container row">
    <div class="row gap">
      <span class="row gap-sm"><span class="dot"></span>CHANNEL · OPEN</span>
      <span class="dim">UNCLASSIFIED // PUBLIC RELEASE</span>
    </div>
    <div class="row gap dim">
      <span class="clock" id="si-clock">—— UTC</span>
      <span>REV {REV}</span>
    </div>
  </div>
</div>

<script>
  const el = document.getElementById('si-clock');
  if (el) {
    const tick = () => {
      const d = new Date();
      const hh = String(d.getUTCHours()).padStart(2, '0');
      const mm = String(d.getUTCMinutes()).padStart(2, '0');
      const ss = String(d.getUTCSeconds()).padStart(2, '0');
      el.textContent = `${hh}:${mm}:${ss} UTC`;
    };
    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  .bar {
    border-bottom: 1px solid var(--si-line);
    background: var(--si-bg-sunken);
    font-family: var(--si-mono);
    font-size: var(--si-fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--si-fg-muted);
  }
  .container {
    max-width: var(--si-max);
    margin: 0 auto;
    padding: 0 var(--si-gutter);
    height: 28px;
  }
  .row { display: flex; align-items: center; justify-content: space-between; }
  .gap { gap: 24px; }
  .gap-sm { gap: 8px; }
  .dim { color: var(--si-fg-dim); }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--si-ok);
    display: inline-block;
  }
  @media (max-width: 640px) {
    .container { padding: 0 var(--si-gutter); height: auto; min-height: 28px; }
    .row { flex-wrap: wrap; gap: 8px; padding: 6px 0; }
  }
</style>
