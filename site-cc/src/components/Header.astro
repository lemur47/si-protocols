---
import ClassificationBar from './ClassificationBar.astro';

const NAV = [
  { label: 'Home',           href: '/' },
  { label: 'Why It Matters', href: '/why-spiritual-intelligence-matters/' },
  { label: 'Common Threats', href: '/common-threats/' },
  { label: 'The Model',      href: '/the-virtualisation-model/' },
  { label: 'Book',           href: '/book/' },
  { label: 'Counterintel',   href: '/counterintelligence/' },
  { label: 'Tools ↗',   href: 'https://spiritualintelligence.dev', external: true },
];

const currentPath = Astro.url.pathname;
---

<header>
  <ClassificationBar />
  <div class="strip">
    <div class="container">
      <a class="brand" href="/">
        <span class="logo">[SI]</span>
        <span class="wordmark">spiritual-intelligence</span>
      </a>
      <button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
      <nav>
        {NAV.map(n => (
          <a
            href={n.href}
            class:list={[
              {
                active:
                  (n.href === '/' && currentPath === '/') ||
                  (n.href !== '/' && currentPath.startsWith(n.href)),
              },
            ]}
            {...(n.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {n.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = toggle?.closest('.container')?.querySelector('nav');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('open');
  });
</script>

<style>
  .strip {
    border-bottom: 1px solid var(--si-line);
    background: var(--si-bg);
  }
  .container {
    max-width: var(--si-max);
    margin: 0 auto;
    padding: 0 var(--si-gutter);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    color: inherit;
  }
  .brand:hover { color: inherit; }
  .logo {
    font-family: var(--si-mono);
    font-size: 18px;
    letter-spacing: 0.04em;
    color: var(--si-amber);
  }
  .wordmark {
    font-family: var(--si-mono);
    font-size: 13px;
    color: var(--si-fg-muted);
    letter-spacing: 0.08em;
  }
  nav {
    display: flex;
    gap: 24px;
    align-items: center;
  }
  nav a {
    font-family: var(--si-mono);
    font-size: 13px;
    color: var(--si-fg-muted);
    letter-spacing: 0.04em;
    transition: color 0.15s;
  }
  nav a:hover,
  nav a.active {
    color: var(--si-amber);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 4px;
  }
  .menu-toggle .bar {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--si-fg-muted);
    border-radius: 1px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .menu-toggle[aria-expanded='true'] .bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .bar:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 760px) {
    .container { flex-wrap: wrap; height: auto; min-height: 56px; padding: 12px var(--si-gutter); }
    .menu-toggle { display: flex; order: 2; }
    nav {
      order: 3;
      width: 100%;
      display: none;
      flex-direction: column;
      gap: 0;
      padding-top: 8px;
      border-top: 1px solid var(--si-line);
      margin-top: 12px;
    }
    nav.open { display: flex; }
    nav a { display: block; padding: 10px 0; }
  }
</style>
